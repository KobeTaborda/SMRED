# ============================================================
#  SMRED - variables de entorno
#  1. Copia este archivo como .env      (copy .env.example .env)
#  2. Cambia TODAS las contraseñas y el SESSION_SECRET
#  El archivo .env está en .gitignore: NUNCA lo subas a GitHub.
#
#  Reglas para contraseñas (SQL Server las exige complejas):
#  - Mínimo 10 caracteres, con mayúsculas, minúsculas, números y un símbolo
#  - Usa solo estos símbolos:  - _ . * @ % +
#  - No uses comillas, $, \, #, ! ni espacios
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Clave para firmar la cookie de sesión (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-una-clave-aleatoria-de-64-caracteres
SESSION_TTL_MINUTES=30

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=smred
# Solo si usas SQL Server Express instalado con instancia con nombre (ej. SQLEXPRESS):
# DB_INSTANCE=SQLEXPRESS

# Contraseña del administrador de SQL Server (solo la usa Docker, nunca la app)
DB_SA_PASSWORD=Cambiar-Sa-2026

# Usuario con el que se conecta la app (lo crea docker compose)
DB_APP_USER=smred_app
DB_APP_PASSWORD=Cambiar-App-2026

# Crea/actualiza las tablas automáticamente al arrancar
DB_MIGRATE_ON_START=true

# --- Administrador inicial de SMRED ---
# Solo se usa la primera vez (cuando no existe ningún usuario).
# Las cuentas de los demás integrantes se crean desde la pantalla Usuarios.
SMRED_ADMIN_USERNAME=admin
SMRED_ADMIN_PASSWORD=Cambiar-Admin-2026
SMRED_ADMIN_FULLNAME=Administrador SMRED

# --- Monitoreo ---
PING_INTERVAL_SECONDS=30
PING_ATTEMPTS=3
PING_TIMEOUT_MS=2000
PING_DEGRADED_MS=200
PING_RETENTION_DAYS=7

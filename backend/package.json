{
  "name": "@smred/backend",
  "version": "0.1.0",
  "private": true,
  "description": "SMRED - API de monitoreo de red (Node.js + Express)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:make": "knex migrate:make"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "node-cron": "^4.6.0",
    "p-limit": "^7.3.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tedious": "^20.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "supertest": "^7.3.0"
  }
}
